# Application
APP_NAME=AI Knowledge Assistant
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_assistant

# Redis (Celery broker/result backend for async document indexing)
REDIS_URL=redis://localhost:6379/0

# LLM provider selection: "openai" or "anthropic" (embeddings always use OpenAI)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Reranking (second-stage pass over vector-search candidates; disabled by default)
RERANK_ENABLED=false
RETRIEVAL_CANDIDATE_COUNT=20
RERANK_TOP_K=5

# Uploads
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=uploads

# Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public auth abuse protection
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

# Conversation history
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_TOKENS=2000

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Email verification delivery
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
FRONTEND_BASE_URL=http://localhost:5173
