# Application
APP_NAME=AI Knowledge Assistant
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_assistant

# Redis (Celery broker/result backend for async document indexing)
REDIS_URL=redis://localhost:6379/0

# LLM provider selection: "openai" or "anthropic" (embeddings always use OpenAI)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Query rewriting: an extra LLM call that expands a terse/informal question
# into a retrieval-optimized query before searching (disabled by default —
# adds latency + cost per question)
QUERY_REWRITING_ENABLED=false

# Groundedness check: an extra LLM-judge call that verifies a generated
# answer's claims are supported by the retrieved context; below the
# threshold, the answer is replaced with a "not enough evidence" message
# (disabled by default — adds latency + cost per question)
GROUNDEDNESS_CHECK_ENABLED=false
GROUNDEDNESS_THRESHOLD=0.5

# Reranking (second-stage pass over vector-search candidates; disabled by default)
RERANK_ENABLED=false
# "lexical" (no extra dependency) or "cross_encoder" (local sentence-transformers
# model, more accurate, adds a PyTorch dependency + one-time model download)
RERANKER_PROVIDER=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_COUNT=20
RERANK_TOP_K=5

# Hybrid search: vector + PostgreSQL full-text keyword search, fused via
# Reciprocal Rank Fusion (disabled by default)
HYBRID_SEARCH_ENABLED=false

# Agent: max sequential tool-calling rounds before a final answer is forced
AGENT_MAX_ITERATIONS=5

# Uploads
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=uploads

# Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public auth abuse protection
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

# Conversation history
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_TOKENS=2000

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Email verification delivery, via the Resend API (https://resend.com) —
# create an account, verify a sending domain (or use their shared test domain
# in development), then create an API key.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM_ADDRESS=Masteacon <onboarding@yourdomain.com>
FRONTEND_BASE_URL=http://localhost:5173
