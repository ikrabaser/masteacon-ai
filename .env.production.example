# Production environment template. Copy to `.env` on the server and fill in
# every placeholder before running `docker compose -f docker-compose.yml -f
# docker-compose.prod.yml up -d --build`. See DEPLOYMENT.md for the full
# walkthrough. Lines marked "MUST CHANGE" are not safe to leave as-is.

# Application
APP_NAME=Masteacon
APP_ENV=production
# MUST CHANGE: the API refuses to start in production if JWT_SECRET_KEY is
# still the dev default (see app/main.py) — this alone won't catch a wrong
# but non-default value, so pick a real long random secret regardless (see
# JWT_SECRET_KEY below), and also turn verbose debug logging/SQL echo off:
DEBUG=false

# The hostname this server will be reached at (no scheme, no path) — used
# by Caddy (docker-compose.prod.yml/Caddyfile) to request its TLS
# certificate and route requests. MUST CHANGE.
DOMAIN=app.yourdomain.com

# Database — docker-compose.yml builds DATABASE_URL for the api/celery_worker
# containers from these three automatically; the API itself refuses to start
# in production with the insecure default password (see app/core/config.py).
# MUST CHANGE POSTGRES_PASSWORD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=ai_knowledge_assistant
# Only matters if you ever run the API outside Docker Compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_assistant
REDIS_URL=redis://localhost:6379/0

# LLM provider selection: "openai" or "anthropic" (embeddings always use OpenAI)
LLM_PROVIDER=openai

# OpenAI — MUST CHANGE (real key)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Optional quality features — each adds latency/cost per question; turn on
# only the ones you've decided you want in production.
QUERY_REWRITING_ENABLED=false
GROUNDEDNESS_CHECK_ENABLED=false
GROUNDEDNESS_THRESHOLD=0.5
RERANK_ENABLED=false
RERANKER_PROVIDER=lexical
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_COUNT=20
RERANK_TOP_K=5
HYBRID_SEARCH_ENABLED=false

# Agent: max sequential tool-calling rounds before a final answer is forced
AGENT_MAX_ITERATIONS=5

# Uploads
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=uploads

# Authentication — MUST CHANGE JWT_SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public auth abuse protection — keep enabled in production.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

# This deployment's chain is Client -> Caddy -> nginx -> API: exactly 1
# trusted hop appends to X-Forwarded-For before the API sees it (see
# app/core/client_ip.py) — MUST be 1 here, or auth rate limiting will key
# every request off Caddy's own IP instead of the real client's.
TRUSTED_PROXY_COUNT=1

# Conversation history
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_TOKENS=2000

# MUST CHANGE: the real origin the frontend is served from once DOMAIN is
# live (frontend and API share one origin behind Caddy — see
# frontend/nginx.conf — so this is just https://<DOMAIN>).
CORS_ORIGINS=https://app.yourdomain.com

# Cloudflare Turnstile — recommended in production to slow down scripted
# registration abuse. MUST CHANGE if enabled (real secret key).
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# Email verification delivery, via Resend (https://resend.com). MUST CHANGE
# (real key + a from-address on a domain you've verified with Resend).
EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM_ADDRESS=Masteacon <onboarding@yourdomain.com>
# MUST CHANGE: verification emails link back here — same as CORS_ORIGINS.
FRONTEND_BASE_URL=https://app.yourdomain.com
