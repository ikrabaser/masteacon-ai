server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Kept in sync with the backend's own MAX_UPLOAD_SIZE_MB (app/core/config.py)
    # by reading the *same* environment variable at container start — see
    # docker-compose.yml, which passes MAX_UPLOAD_SIZE_MB into this container's
    # environment, and the templating mechanism below. Without this, nginx's
    # default (1MB) would 413 any upload the backend would otherwise accept.
    # This file is processed by the official nginx image's envsubst-on-start
    # templating (hence the .template name/location — see frontend/Dockerfile);
    # `$host`/`$remote_addr`/etc. below are nginx's own variables, left alone
    # because they aren't environment variable names.
    client_max_body_size ${MAX_UPLOAD_SIZE_MB}m;

    # Reverse-proxy the API under the same origin as the frontend, so the
    # built JS never needs a hardcoded API domain baked in at build time
    # (VITE_API_BASE_URL="" — see docker-compose.yml) and every request is
    # same-origin (no CORS involved at all when accessed through this proxy).
    # `api` here is the Docker Compose service name/DNS entry.
    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The backend's health checks live at the root (/health*, not /api/v1/...)
    # — without this, they'd fall through to the SPA's try_files below and
    # return index.html with a 200, which is what DEPLOYMENT.md's `curl
    # .../health` verification step (and any uptime monitor/orchestrator
    # pointed at these paths) actually needs to hit the real backend, not the
    # frontend shell.
    location ~ ^/health(/live|/ready)?$ {
        proxy_pass http://api:8000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets are content-hashed by Vite — safe to cache aggressively.
    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
